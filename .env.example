# Environment variables example for TripWripp
# Copy this file to .env.local and fill in values before building in production.

# Admin token used to authorize access to /admin dashboard and CSV/data exports.
# Generate a strong random value (GUID or 32+ hex chars)
CONTACT_ADMIN_TOKEN=replace-with-strong-random-token

# (Optional) Node environment (Vercel sets automatically)
# NODE_ENV=production

# (Optional) Analytics / 3rd party keys can go here later
# NEXT_PUBLIC_ANALYTICS_ID=
